# Copy to .env.local. NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-only API base (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000/api/v1
# Phase 3+: public media origin (Cloudflare R2 custom domain; RustFS locally)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/media-public

# Shared with the API (REVALIDATE_SECRET there). Lets the API refresh cached pages after changes.
# Generate with: openssl rand -base64 48
# REVALIDATE_SECRET=
