# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Phase 2: database and cache
# Neon pooled endpoint (hostname contains "-pooler"). Local alternative:
#   postgresql://ecommerce:ecommerce@localhost:5442/ecommerce
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ecommerce
RATE_LIMIT_PER_MINUTE=300

# Public media origin (Cloudflare R2 custom domain). Optional until uploads exist (Phase 8).

# Later phases: see docs/ENVIRONMENT.md

# Storefront cache refresh hook (set both or neither). Use the same secret in the storefront.
# STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=

# Phase 5: authentication. Generate secrets with:
#   openssl rand -base64 48   (JWT_ACCESS_SECRET)
#   openssl rand -base64 32   (MFA_ENCRYPTION_KEY; keep it safe: losing it invalidates enrolled authenticators)
JWT_ACCESS_SECRET=
MFA_ENCRYPTION_KEY=
JWT_ACCESS_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Email (Mailpit locally: SMTP localhost:1025, UI http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Laptops & Electronics <no-reply@localhost>"

# Development only. Simulates M-Pesa so checkout can be tested without real money.
# Refused when NODE_ENV=production. Takes precedence over the Daraja settings below.
PAYMENTS_SIMULATED=true

# Phase 7: M-Pesa through Safaricom Daraja (Lipa na M-Pesa Online). Set all five credentials or none.
# Sandbox app: https://developer.safaricom.co.ke (test short code 174379 and its passkey are listed there).
# To use the sandbox locally, set PAYMENTS_SIMULATED=false and expose the API over https (e.g. a tunnel).
MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# Random URL-safe string, 24+ characters: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# MPESA_CALLBACK_SECRET=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number for CustomerBuyGoodsOnline (defaults to MPESA_SHORTCODE)
# MPESA_PARTY_B=
# Public https origin Safaricom calls back. Defaults to API_PUBLIC_URL.
# MPESA_CALLBACK_BASE_URL=https://your-tunnel.example.com
# Optional comma-separated callback source IP allowlist (Safaricom publishes its addresses).
# MPESA_ALLOWED_IPS=
# Live money: MPESA_ENV=production is refused unless this is true. Only set it with the owner's sign-off.
PAYMENTS_LIVE_APPROVED=false

# Phase 8: object storage. Locally this is RustFS from docker compose (run `pnpm --filter @repo/api storage:init` once).
# In production use Cloudflare R2: set R2_ACCOUNT_ID and remove S3_ENDPOINT_OVERRIDE.
S3_ENDPOINT_OVERRIDE=http://localhost:9000
R2_ACCESS_KEY_ID=devaccesskey
R2_SECRET_ACCESS_KEY=devsecretkey
R2_PUBLIC_BUCKET=media-public
R2_PRIVATE_BUCKET=media-private
R2_PUBLIC_BASE_URL=http://localhost:9000/media-public
# Production example:
# R2_ACCOUNT_ID=<32 hex characters>
# R2_PUBLIC_BASE_URL=https://media.example.co.ke
