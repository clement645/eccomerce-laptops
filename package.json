{
  "name": "electronics-commerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "dev:packages": "pnpm --filter \"./packages/**\" -r --parallel dev",
    "predev": "pnpm build:packages",
    "dev": "pnpm --filter @repo/api --filter @repo/storefront --filter @repo/admin --parallel run \"/^dev(:worker)?$/\"",
    "dev:api": "pnpm build:packages && pnpm --filter @repo/api dev",
    "dev:storefront": "pnpm build:packages && pnpm --filter @repo/storefront dev",
    "dev:admin": "pnpm build:packages && pnpm --filter @repo/admin dev",
    "build": "pnpm build:packages && pnpm --filter \"./apps/**\" -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm --filter @repo/e2e test:e2e",
    "test:load": "pnpm --filter @repo/e2e load",
    "lighthouse": "pnpm --filter @repo/e2e lighthouse",
    "db:generate": "pnpm --filter @repo/database generate",
    "db:migrate:create": "pnpm --filter @repo/database migrate:create",
    "db:migrate:dev": "pnpm --filter @repo/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/database migrate:deploy",
    "db:migrate:status": "pnpm --filter @repo/database migrate:status",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:seed:local": "pnpm --filter @repo/database seed:local",
    "db:studio": "pnpm --filter @repo/database studio",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "clean": "pnpm -r exec rm -rf dist .next .turbo coverage",
    "dev:worker": "pnpm --filter @repo/api dev:worker"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  }
}
