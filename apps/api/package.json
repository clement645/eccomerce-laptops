{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS REST API for the electronics e-commerce platform",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config ./vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "admin:create": "node --env-file-if-exists=.env dist/cli/create-admin.js",
    "storage:init": "node --env-file-if-exists=.env dist/cli/init-storage.js",
    "dev:worker": "node --watch-path=dist dist/worker.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@repo/configuration": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/validation": "workspace:*",
    "argon2": "0.45.1",
    "aws4fetch": "1.0.20",
    "bullmq": "6.3.14",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1"
  }
}
