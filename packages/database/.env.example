# Copy to .env (git-ignored). Used by the Prisma CLI and the seed script.

# Neon: pooled endpoint (runtime) and direct endpoint (migrations: hostname without "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Local Docker databases (defaults shown; only set these to override).
# LOCAL_DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5442/ecommerce"
# LOCAL_SHADOW_DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5442/ecommerce_shadow"
# TEST_DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5442/ecommerce_test"
